# Banco de dados (SQLite local — o arquivo fica em prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Provedor de tradução: anthropic | mock
TRANSLATION_PROVIDER="anthropic"

# Chave da API Anthropic — usada APENAS no servidor, nunca exposta ao navegador.
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Modelo usado para tradução contextual
ANTHROPIC_MODEL="claude-sonnet-5"

# Caminho para o binário do yt-dlp (opcional).
# Se vazio, o app procura "yt-dlp" no PATH; se não encontrar,
# a opção "Detectar legenda automaticamente" fica desabilitada.
YTDLP_PATH=""
